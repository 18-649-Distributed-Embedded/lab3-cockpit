# Add to /boot/firmware/config.txt on current Raspberry Pi OS.
# Confirm XIAO MCP2515 oscillator marking is 16.000 MHz before using this.

dtparam=spi=on

# CAN A: SPI0 CE0, INT -> GPIO25 / physical pin 22
dtoverlay=mcp2515-can0,oscillator=16000000,interrupt=25

# CAN B: SPI0 CE1, INT -> GPIO24 / physical pin 18
dtoverlay=mcp2515-can1,oscillator=16000000,interrupt=24