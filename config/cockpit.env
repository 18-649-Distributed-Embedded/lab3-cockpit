# UDP input from the Lab 2 laptop wheel proxy.
# Use 0.0.0.0 if the Pi address changes between networks.
UDP_BIND=0.0.0.0
UDP_PORT=8000
UDP_PACKET_SIZE=276
UDP_TIMEOUT_S=0.150

# SocketCAN interfaces created by the Pi MCP2515 overlays.
CAN_A=can0
CAN_B=can1
CAN_BITRATE=500000

# Periodic behavior.
CONTROL_PERIOD_S=0.020
HEARTBEAT_PERIOD_S=0.020
BLINK_TOGGLE_PERIOD_S=0.500
HEARTBEAT_TIMEOUT_S=0.060

# Raspberry Pi BCM GPIO numbers
# Physical header pins: UDPRX=16, CMDTX=12, CANTXA=15, CANTXB=13.
UDPRX_GPIO=23
CMDTX_GPIO=18
CANTXA_GPIO=22
CANTXB_GPIO=27
DEGA_GPIO=5
DEGB_GPIO=6
TESTPOINT_PULSE_S=0.001